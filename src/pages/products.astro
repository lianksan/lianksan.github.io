---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/site';

const ios = products.filter((p) => p.category === 'ios');
// Нижний ряд — две колонки со списками
const lists = [
  { title: 'Web services', items: products.filter((p) => p.category === 'web') },
  // В макете «Resourses» — похоже на опечатку
  { title: 'Resources', items: products.filter((p) => p.category === 'resources') },
];
---

<Base
  title="Products — Paulik"
  description="iOS applications, web services and resources made by Paulik Liankevich."
  current="products"
>
  <div class="content">
    <section class="section">
      <h2 class="h2">iOS applications</h2>
      <ul class="grid">
        {
          ios.map((p) => (
            <li>
              <ProductCard product={p} variant="large" />
            </li>
          ))
        }
      </ul>
    </section>

    <div class="columns">
      {
        lists.map((list) => (
          <section class="section">
            <h2 class="h2">{list.title}</h2>
            <ul class="list">
              {list.items.map((p) => (
                <li>
                  <ProductCard product={p} variant="row" />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: 60px;
    width: min(var(--column-width), calc(100% - 80px));
    margin: 0 auto;
    padding: 40px 0;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .grid,
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 8px;
  }

  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media (max-width: 1023px) {
    .content {
      gap: 48px;
      width: auto;
      max-width: calc(var(--column-width) + 2 * var(--page-gutter));
      padding: 16px var(--page-gutter) 56px;
    }

    .grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    }

    .columns {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
