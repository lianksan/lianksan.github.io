---
import Base from '../layouts/Base.astro';
import { nav } from '../data/site';
---

<Base
  title="Cases — Paulik"
  description="In-depth product design case studies by Paulik Liankevich. Coming soon — meanwhile, see the shots gallery."
  current="cases"
>
  <!--
    Пустое состояние: логотип EMPTY летает внутри рамки и отскакивает от стенок, как DVD-заставка.
    Логотип — маска из SVG, поэтому его цвет можно менять через --logo-color.
  -->
  <div class="empty" data-bounce-box>
    <div class="empty__logo" role="img" aria-label="Oops, empty: cases are in development" data-bounce-item></div>
    <!-- Подпись по центру поверх логотипа -->
    <p class="empty__caption body">
      There are no cases yet.<br />
      Check out <a class="link link--accent" href={nav.shots}>Shots</a> and <a class="link link--accent" href={nav.products}>Products</a>
    </p>
  </div>
</Base>

<script>
  /** Скорость полёта, px/с */
  const SPEED = 226;

  /** Насколько направление может отклоняться от диагонали */
  const MAX_TILT = (15 * Math.PI) / 180;

  /** Цвета логотипа: приглушённая радуга и тёмно-серый. На старте и после каждого отскока — случайный */
  const COLORS = ['#555555', '#c0625a', '#cf8a4f', '#c9a645', '#6c9a5e', '#5b9aae', '#5571b0', '#8566a8'];

  let cleanup: (() => void) | undefined;
  /** Рамка, в которой логотип уже летает: повторный запуск для неё не нужен */
  let running: HTMLElement | undefined;

  function start() {
    const box = document.querySelector<HTMLElement>('[data-bounce-box]') ?? undefined;
    if (box && box === running) return;

    cleanup?.();
    cleanup = undefined;
    running = undefined;

    const item = box?.querySelector<HTMLElement>('[data-bounce-item]');
    if (!box || !item) return;
    // Стартовый цвет — случайный из всей палитры (и без анимации), серый тоже может выпасть
    let color = COLORS[Math.floor(Math.random() * COLORS.length)];
    item.style.setProperty('--logo-color', color);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let maxX = 0;
    let maxY = 0;
    const measure = () => {
      maxX = Math.max(0, box.clientWidth - item.offsetWidth);
      maxY = Math.max(0, box.clientHeight - item.offsetHeight);
    };
    measure();

    // Стартуем из центра (там же логотип стоит без JS) по одной из диагоналей ±15°:
    // при отскоках угол к стенкам сохраняется, поэтому логотип всё время летает к углам
    let x = maxX / 2;
    let y = maxY / 2;
    const diagonal = (Math.floor(Math.random() * 4) * 2 + 1) * (Math.PI / 4);
    const angle = diagonal + (Math.random() * 2 - 1) * MAX_TILT;
    let vx = SPEED * Math.cos(angle);
    let vy = SPEED * Math.sin(angle);
    let last = performance.now();
    let frame = 0;

    item.dataset.moving = '';
    const place = () => (item.style.transform = `translate3d(${x}px, ${y}px, 0)`);
    place();

    const recolor = () => {
      const others = COLORS.filter((c) => c !== color);
      color = others[Math.floor(Math.random() * others.length)];
      item.style.setProperty('--logo-color', color);
    };

    const tick = (now: number) => {
      // Ограничиваем шаг, чтобы после неактивной вкладки логотип не «телепортировался»
      // Время кадра из rAF бывает чуть раньше performance.now() на старте — без отрицательного шага назад
      const dt = Math.min(Math.max(now - last, 0), 50) / 1000;
      last = now;
      x += vx * dt;
      y += vy * dt;
      let bounced = false;
      // Если рамка по оси не больше логотипа (очень низкое окно) — стоим, а не отскакиваем каждый кадр
      if (maxX === 0) x = 0;
      else if (x <= 0) (x = 0), (vx = Math.abs(vx)), (bounced = true);
      else if (x >= maxX) (x = maxX), (vx = -Math.abs(vx)), (bounced = true);
      if (maxY === 0) y = 0;
      else if (y <= 0) (y = 0), (vy = Math.abs(vy)), (bounced = true);
      else if (y >= maxY) (y = maxY), (vy = -Math.abs(vy)), (bounced = true);
      // Удар в угол — одна смена цвета, а не две
      if (bounced) recolor();
      place();
      frame = requestAnimationFrame(tick);
    };
    frame = requestAnimationFrame(tick);

    const resize = new ResizeObserver(() => {
      measure();
      x = Math.min(x, maxX);
      y = Math.min(y, maxY);
    });
    resize.observe(box);
    resize.observe(item);

    running = box;
    cleanup = () => {
      cancelAnimationFrame(frame);
      resize.disconnect();
    };
  }

  // При первом открытии страницы astro:page-load может сработать раньше, чем выполнится этот скрипт,
  // и логотип так и не полетит — поэтому стартуем и сразу. Двойного запуска нет: start() его пропускает
  start();
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
    running = undefined;
  });
</script>

<style>
  .empty {
    position: relative;
    height: calc(100dvh - 2 * 40px);
    margin: 40px;
    overflow: hidden;
    border: 1px solid var(--color-frame-border);
    border-radius: var(--radius-tile);
    background: var(--color-surface);
  }

  .empty__caption {
    position: absolute;
    top: 50%;
    right: 16px;
    left: 16px;
    color: var(--color-primary);
    text-align: center;
    transform: translateY(-50%);
  }

  /* Пропорции ровно по SVG (150×69), чтобы логотип касался стенок самим рисунком */
  .empty__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 260px;
    aspect-ratio: 150 / 69;
    background-color: var(--logo-color, #555);
    mask: url('/icons/empty.svg') no-repeat center / contain;
    transform: translate(-50%, -50%);
    /* Поверх подписи, но не мешает выделять текст и нажимать ссылки под собой */
    z-index: 1;
    pointer-events: none;
  }

  /* Во время полёта позиция задаётся из скрипта через transform */
  .empty__logo[data-moving] {
    top: 0;
    left: 0;
    /* Отдельный слой на GPU: сдвиг без перерисовки, иначе на телефонах подёргивается */
    will-change: transform;
  }

  /* Cases 960-1279 */
  @media (max-width: 1279px) {
    .empty {
      height: calc(100dvh - 2 * 28px);
      margin: 28px;
    }

    .empty__logo {
      width: 200px;
    }
  }

  /* Cases 959-: рамка под меню по ширине экрана */
  @media (max-width: 959px) {
    .empty {
      height: calc(100dvh - 44px - 2 * 16px);
      min-height: 320px;
      margin: 16px;
    }

    .empty__logo {
      width: 150px;
    }
  }
</style>
