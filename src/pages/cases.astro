---
import Base from '../layouts/Base.astro';
---

<Base
  title="Cases — Paulik"
  description="Project cases by Paulik Liankevich are in development."
  current="cases"
>
  <!--
    Пустое состояние: логотип EMPTY летает внутри рамки и отскакивает от стенок, как DVD-заставка.
    Логотип — маска из SVG, поэтому его цвет можно менять через --logo-color.
  -->
  <div class="empty" data-bounce-box>
    <div class="empty__logo" role="img" aria-label="Oops, empty: cases are in development" data-bounce-item></div>
  </div>
</Base>

<script>
  /** Скорость полёта, px/с */
  const SPEED = 226;

  /** Цвета логотипа: приглушённая радуга и чёрный. После каждого отскока — случайный другой */
  const COLORS = ['#111111', '#c0625a', '#cf8a4f', '#c9a645', '#6c9a5e', '#5b9aae', '#5571b0', '#8566a8'];

  let cleanup: (() => void) | undefined;

  function start() {
    cleanup?.();
    cleanup = undefined;

    const box = document.querySelector<HTMLElement>('[data-bounce-box]');
    const item = box?.querySelector<HTMLElement>('[data-bounce-item]');
    if (!box || !item) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let maxX = 0;
    let maxY = 0;
    const measure = () => {
      maxX = Math.max(0, box.clientWidth - item.offsetWidth);
      maxY = Math.max(0, box.clientHeight - item.offsetHeight);
    };
    measure();

    // Стартуем из центра (там же логотип стоит без JS) под случайным углом 0–360°
    let x = maxX / 2;
    let y = maxY / 2;
    const angle = Math.random() * 2 * Math.PI;
    let vx = SPEED * Math.cos(angle);
    let vy = SPEED * Math.sin(angle);
    let last = performance.now();
    let frame = 0;

    item.dataset.moving = '';
    const place = () => (item.style.transform = `translate(${x}px, ${y}px)`);
    place();

    let color = COLORS[0];
    const recolor = () => {
      const others = COLORS.filter((c) => c !== color);
      color = others[Math.floor(Math.random() * others.length)];
      item.style.setProperty('--logo-color', color);
    };

    const tick = (now: number) => {
      // Ограничиваем шаг, чтобы после неактивной вкладки логотип не «телепортировался»
      const dt = Math.min(now - last, 50) / 1000;
      last = now;
      x += vx * dt;
      y += vy * dt;
      let bounced = false;
      // Если рамка по оси не больше логотипа (очень низкое окно) — стоим, а не отскакиваем каждый кадр
      if (maxX === 0) x = 0;
      else if (x <= 0) (x = 0), (vx = Math.abs(vx)), (bounced = true);
      else if (x >= maxX) (x = maxX), (vx = -Math.abs(vx)), (bounced = true);
      if (maxY === 0) y = 0;
      else if (y <= 0) (y = 0), (vy = Math.abs(vy)), (bounced = true);
      else if (y >= maxY) (y = maxY), (vy = -Math.abs(vy)), (bounced = true);
      // Удар в угол — одна смена цвета, а не две
      if (bounced) recolor();
      place();
      frame = requestAnimationFrame(tick);
    };
    frame = requestAnimationFrame(tick);

    const resize = new ResizeObserver(() => {
      measure();
      x = Math.min(x, maxX);
      y = Math.min(y, maxY);
    });
    resize.observe(box);
    resize.observe(item);

    cleanup = () => {
      cancelAnimationFrame(frame);
      resize.disconnect();
    };
  }

  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

<style>
  .empty {
    position: relative;
    height: calc(100dvh - 2 * 40px);
    margin: 40px;
    overflow: hidden;
    border: 1px solid var(--color-frame-border);
    border-radius: var(--radius-tile);
    background: var(--color-surface);
  }

  /* Пропорции ровно по SVG (150×68), чтобы логотип касался стенок самим рисунком; масштаб ×1.7 */
  .empty__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(150px * 1.7);
    height: calc(68px * 1.7);
    background-color: var(--logo-color, var(--color-primary));
    mask: url('/icons/empty.svg') no-repeat center / contain;
    transform: translate(-50%, -50%);
  }

  /* На мобилке рамка по ширине экрана, под меню; логотип мельче */
  @media (max-width: 1023px) {
    .empty {
      height: calc(100dvh - 76px - 2 * var(--page-gutter));
      min-height: 320px;
      margin: var(--page-gutter);
    }

    .empty__logo {
      width: calc(150px * 1.1);
      height: calc(68px * 1.1);
    }
  }

  /* Во время полёта позиция задаётся из скрипта через transform */
  .empty__logo[data-moving] {
    top: 0;
    left: 0;
  }
</style>
