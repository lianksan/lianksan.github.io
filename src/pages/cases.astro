---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base';
import '../styles/cases.css';
import { GALLERY } from '../data/gallery';
---

<Base title="Gallery" activeTab="cases">

  {GALLERY.map(section => (
    <section class="portfolio-block gallery-section wide">
      <h2 class="h1">{section.years}</h2>
      <div class="shots-grid">
        {section.rows.flatMap(row => {
          const usedCols = row.reduce((s, shot) => s + (shot.col || 0), 0);
          const autoCount = row.filter(shot => !shot.col).length;
          const autoSpan = autoCount ? (6 - usedCols) / autoCount : 0;
          return row.map(shot => {
            const span = shot.col || autoSpan;
            // the shot and its variants, left to right in the carousel
            const variants = [shot.src, ...(shot.stack || [])];
            const media = (src: string, cls: string) => /\.mp4$/i.test(src)
              ? <video class={cls} src={withBase(src)} autoplay muted loop playsinline></video>
              : <img class={cls} src={withBase(src)} alt="" />;
            return (
              <div class={`shot-wrap col-${span}${shot.desktopOnly ? ' desktop-only' : ''}`} data-carousel={shot.stack ? '' : undefined}>
                {shot.stack
                  ? <div class="shot-carousel">{variants.map(src => media(src, 'shot-img shot-carousel__slide'))}</div>
                  : media(shot.src, 'shot-img')
                }
                {(shot.desc || shot.stack) && (
                  <div class="shot-caption">
                    {shot.desc && <p class="body-text shot-desc" set:html={shot.desc} />}
                    {shot.stack && (
                      <div class="shot-pager">
                        <button type="button" class="shot-pager__btn" data-step="-1" aria-label="Previous variant" disabled><svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.5 1L1.5 6L6.5 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                        <span class="body-text shot-pager__count"><span data-current>1</span> / {variants.length}</span>
                        <button type="button" class="shot-pager__btn" data-step="1" aria-label="Next variant"><svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                      </div>
                    )}
                  </div>
                )}
              </div>
            );
          });
        })}
      </div>
    </section>
  ))}

</Base>

<script>
  // shot carousels: swiped by hand, scrolled one slide at a time by the arrows
  // or by a click on a slide peeking from the side;
  // the counter and the arrows follow whatever slide is in view
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(wrap => {
    const track = wrap.querySelector<HTMLElement>('.shot-carousel')!;
    const slides = [...track.children] as HTMLElement[];
    const counter = wrap.querySelector<HTMLElement>('[data-current]')!;
    const [prev, next] = wrap.querySelectorAll<HTMLButtonElement>('.shot-pager__btn');
    // slide offsets are measured from the first one, so the track's padding doesn't count
    const offset = (i: number) => slides[i].offsetLeft - slides[0].offsetLeft;
    const current = () => {
      const x = track.scrollLeft;
      return slides.reduce((best, _, i) =>
        Math.abs(offset(i) - x) < Math.abs(offset(best) - x) ? i : best, 0);
    };
    const sync = () => {
      const i = current();
      counter.textContent = String(i + 1);
      slides.forEach((slide, n) => slide.classList.toggle('is-current', n === i));
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
    };
    const goTo = (i: number) => track.scrollTo({ left: offset(i), behavior: 'smooth' });
    const go = (step: number) => goTo(Math.min(Math.max(current() + step, 0), slides.length - 1));
    // a click on a slide peeking from the side brings it into view
    slides.forEach((slide, i) => slide.addEventListener('click', () => {
      if (i !== current()) goTo(i);
    }));
    // let the track run out to the window edges on both sides of the shot
    const bleed = () => {
      const { left, right } = wrap.getBoundingClientRect();
      track.style.setProperty('--bleed-left', `${left}px`);
      track.style.setProperty('--bleed-right', `${document.documentElement.clientWidth - right}px`);
      track.scrollLeft = offset(current());
    };
    bleed();
    addEventListener('resize', bleed);
    sync();
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', sync, { passive: true });
  });
</script>
