---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base';
import '../styles/cases.css';
import { GALLERY } from '../data/gallery';
---

<Base title="Portfolio" activeTab="cases">

  {GALLERY.map(section => (
    <section class="portfolio-block gallery-section wide">
      <h2 class="h1">{section.years}</h2>
      <div class="shots-grid">
        {section.rows.flatMap(row => {
          const usedCols = row.reduce((s, shot) => s + (shot.col || 0), 0);
          const autoCount = row.filter(shot => !shot.col).length;
          const autoSpan = autoCount ? (6 - usedCols) / autoCount : 0;
          return row.map(shot => {
            const span = shot.col || autoSpan;
            // the shot and its variants; the first lies on top of the pile
            const variants = [shot.src, ...(shot.stack || [])];
            const media = (src: string, cls: string, pos?: number) => /\.mp4$/i.test(src)
              ? <video class={cls} data-pos={pos} src={withBase(src)} autoplay muted loop playsinline></video>
              : <img class={cls} data-pos={pos} src={withBase(src)} alt="" />;
            return (
              <div class={`shot-wrap col-${span}${shot.desktopOnly ? ' desktop-only' : ''}`} data-stack={shot.stack ? '' : undefined}>
                {shot.stack
                  ? <div class="shot-stack">{variants.map((src, i) => media(src, 'shot-img shot-stack__layer', i))}</div>
                  : media(shot.src, 'shot-img')
                }
                {(shot.desc || shot.stack) && (
                  <div class="shot-caption">
                    {shot.desc && <p class="body-text shot-desc" set:html={shot.desc} />}
                    {shot.stack && (
                      <div class="shot-pager">
                        <button type="button" class="shot-pager__btn" data-step="-1" aria-label="Previous variant"><svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.5 1L1.5 6L6.5 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                        <span class="body-text shot-pager__count"><span data-current>1</span> / {variants.length}</span>
                        <button type="button" class="shot-pager__btn" data-step="1" aria-label="Next variant"><svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                      </div>
                    )}
                  </div>
                )}
              </div>
            );
          });
        })}
      </div>
    </section>
  ))}

</Base>

<script>
  // stacked shots: the arrows (or a click on the pile) bring the next variant on top;
  // the rest keep their order after it, so the pile turns like a carousel
  document.querySelectorAll<HTMLElement>('[data-stack]').forEach(wrap => {
    const layers = [...wrap.querySelectorAll<HTMLElement>('.shot-stack__layer')];
    const counter = wrap.querySelector<HTMLElement>('[data-current]')!;
    let current = 0;
    const show = (n: number) => {
      current = (n + layers.length) % layers.length;
      layers.forEach((layer, i) => {
        layer.dataset.pos = String((i - current + layers.length) % layers.length);
      });
      counter.textContent = String(current + 1);
    };
    wrap.querySelectorAll<HTMLElement>('.shot-pager__btn').forEach(btn =>
      btn.addEventListener('click', () => show(current + Number(btn.dataset.step))));
    wrap.querySelector('.shot-stack')!.addEventListener('click', () => show(current + 1));
  });
</script>
