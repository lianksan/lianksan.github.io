---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Lightbox from '../components/Lightbox.astro';
import { shotSections, captionParts } from '../data/shots';

const COLUMNS = 6;
const CONTENT_WIDTH = 960;
---

<Base
  title="Gallery — Paulik"
  description="Shots of product design work by Paulik Liankevich."
  current="shots"
>
  <div class="content" style={`--content-width: ${CONTENT_WIDTH}px`}>
    {
      shotSections.map((section) => (
        <details class="section" open>
          <summary class="section__title">
            <img src="/icons/chevron.svg" alt="" width="20" height="20" class="chevron" />
            <h2 class="underline h2">{section.title}</h2>
          </summary>

          <div class="section__shots">
            {section.shots.map((shot) => (
              <figure class:list={['shot', { 'shot--split': Array.isArray(shot.caption) }]}>
                {shot.rows.map((row) => (
                  <div class="row">
                    {row.map((m, i) => {
                      const span = m.span ?? COLUMNS;
                      const sizes = `(max-width: 680px) calc(100vw - 16px), ${Math.round((span / COLUMNS) * CONTENT_WIDTH)}px`;
                      const style = `grid-column: span ${span}; --i: ${i}`;
                      return 'stack' in m ? (
                        <div class="stack" style={style}>
                          {m.stack.map((s) => (
                            <Media {...s} sizes={sizes} />
                          ))}
                        </div>
                      ) : (
                        <Media {...m} sizes={sizes} style={style} />
                      );
                    })}
                  </div>
                ))}
                {typeof shot.caption === 'string' && (
                  <figcaption class="body">
                    {captionParts(shot.caption).map((part) =>
                      typeof part === 'string' ? (
                        part
                      ) : (
                        <a
                          class="link link--accent"
                          href={part.href}
                          {...(part.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                        >
                          {part.text}
                        </a>
                      ),
                    )}
                  </figcaption>
                )}
                {Array.isArray(shot.caption) && (
                  <figcaption class="row">
                    {shot.caption.map((c, i) => (
                      <span class="body" style={`grid-column: span ${c.span}; --i: ${i}`}>
                        {c.text}
                      </span>
                    ))}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </details>
      ))
    }
  </div>
  <Lightbox />
</Base>

<style>
  .content {
    display: flex;
    flex-direction: column;
    /* Между блоками 24px; свёрнутый блок добавляет 12px снизу, раскрытый — 24px (итого 48) */
    gap: 24px;
    /* Контент не шире --content-width + поля по 60px, по центру области */
    max-width: calc(var(--content-width) + 2 * 60px);
    margin: 0 auto;
    padding: 40px 60px 47px;
  }

  .section__title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    list-style: none;
  }

  .section__title::-webkit-details-marker {
    display: none;
  }

  .section__title:hover h2 {
    text-decoration-color: currentColor;
  }

  .section:not([open]) {
    padding-bottom: 12px;
  }

  .section[open]:not(:last-child) {
    padding-bottom: 24px;
  }

  .section:not([open]) .chevron {
    transform: rotate(-90deg);
  }

  .section__shots {
    display: flex;
    flex-direction: column;
    gap: 40px;
    /* 8px под заголовком + 32px, как в Figma */
    padding-top: 40px;
  }

  .shot {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
    align-items: start;
  }

  figcaption {
    max-width: 600px;
    color: var(--color-secondary);
  }

  figcaption.row {
    max-width: none;
  }

  /* Колонка плиток друг над другом */
  .stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Плитка рядом с колонкой — на всю её высоту, обрезается по краям */
  @media (min-width: 681px) {
    .row > :global(.media--fill) {
      align-self: stretch;
      aspect-ratio: auto !important;
    }

    /* Картинка не влияет на высоту ряда — её задают соседи */
    .row > :global(.media--fill) :global(:is(img, video)) {
      position: absolute;
      inset: 0;
    }
  }

  @media (max-width: 959px) {
    .content {
      padding: 16px 16px 40px;
    }

    .section[open]:not(:last-child) {
      padding-bottom: 16px;
    }

    .section__shots {
      gap: 24px;
      padding-top: 24px;
    }

    /* Картинки шотов — вдвое ближе к краям экрана (8px), подписи и заголовки — как были (16px) */
    .row:not(figcaption) {
      margin-inline: -8px;
    }

    /* Между плитками 6px, между плитками и подписью — 8px, как было */
    .shot,
    .row,
    .stack {
      gap: 6px;
    }

    .shot > figcaption {
      margin-top: 2px;
    }
  }

  /* Подписи под колонками стоят по тем же колонкам, что и плитки; первая — с отступом 16px от края */
  @media (min-width: 681px) and (max-width: 959px) {
    figcaption.row {
      margin-inline: -8px;
    }

    figcaption.row > span:first-child {
      padding-left: 8px;
    }
  }

  /* До 680px — по одной плитке в ряду */
  @media (max-width: 680px) {
    /* Перебиваем span из style */
    .row > :global(*) {
      grid-column: 1 / -1 !important;
    }

    /*
     * Шот с подписью у каждой плитки: ряды «раскрываются» в саму фигуру,
     * и каждая подпись встаёт под свою плитку (порядок по --i)
     */
    .shot--split .row {
      display: contents;
    }

    /* Ряд «раскрыт», поэтому отступ к краям даём самим плиткам */
    .shot--split .row:not(figcaption) > :global(*) {
      width: auto;
      margin-inline: -8px;
    }

    .shot--split figcaption.row > span {
      margin-top: 2px;
    }

    .shot--split .row > :global(*) {
      order: calc(var(--i) * 2);
    }

    .shot--split figcaption.row > span {
      order: calc(var(--i) * 2 + 1);
    }

    .shot--split figcaption.row > span:not(:last-child) {
      margin-bottom: 16px;
    }
  }
</style>
