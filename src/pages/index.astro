---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import ContactLinks from '../components/ContactLinks.astro';
import video1 from '../assets/home/video-1.mp4';
import video2 from '../assets/home/video-2.mp4';
import video3 from '../assets/home/video-3.mp4';

// Ширина плиток из Figma при высоте 260px; видео заполняет плитку с обрезкой (cover)
const clips = [
  { src: video1, width: 260, alt: 'Walking in Rome' },
  { src: video2, width: 195, alt: 'Skiing' },
  { src: video3, width: 238, alt: 'Playing basketball' },
];
---

<Base
  title="Paulik Liankevich"
  description="Product designer with a penchant for development. Currently in Vilnius and open for new projects."
  current="home"
>
  <div class="content">
    <header class="header">
      <div class="texts">
        <h1 class="h1">Product designer</h1>
        <p class="h2">with a penchant for development.<br /> Currently in Vilnius and open for new projects</p>
      </div>

      <div class="clips">
        {
          clips.map((clip) => (
            <div class="clip" style={`--clip-width: ${clip.width}`}>
              <video src={clip.src} autoplay muted loop playsinline aria-label={clip.alt} />
            </div>
          ))
        }
      </div>
    </header>

    <Timeline />

    <footer class="footer">
      <p class="h2">
        I want to develop products that move<br class="desktop-only" /> humanity forward, making people healthier<br class="desktop-only" /> and more conscious
      </p>

      <div class="contact contact--desktop">
        <img class="contact__highlight" src="/icons/highlight.svg" alt="" width="252" height="58" />
        <p class="contact__text h3">Let’s stay in touch</p>
        <div class="contact__arrow" aria-hidden="true">
          <img src="/icons/contact-arrow.svg" alt="" width="123" height="34" />
        </div>
      </div>

      <!-- Main 959-: сайдбара нет, контакты прямо под подписью -->
      <div class="contact-mobile">
        <p class="h3">Let’s stay in touch</p>
        <ContactLinks />
      </div>
    </footer>
  </div>
</Base>

<style>
  /* Колонка до 760px с полями по 60px (Scrollable content в Figma) */
  .content {
    display: flex;
    flex-direction: column;
    gap: 52px;
    max-width: calc(var(--column-width) + 2 * 60px);
    margin: 0 auto;
    padding: 32px 60px 100px;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .texts {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .clips {
    --clip-height: 260;

    display: flex;
    gap: 8px;
  }

  /* Ширина из Figma задана при высоте 260px — на меньших экранах масштабируем пропорционально */
  .clip {
    flex: none;
    width: calc(var(--clip-width) / 260 * var(--clip-height) * 1px);
    height: calc(var(--clip-height) * 1px);
    overflow: hidden;
    border: 1px solid var(--color-tile-border);
    border-radius: var(--radius-tile);
    background: var(--color-placeholder);
  }

  .clip video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .footer {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* Обведённая от руки подпись со стрелкой к контактам в сайдбаре */
  .contact {
    position: relative;
    width: 198px;
    height: 56px;
  }

  .contact__highlight {
    position: absolute;
    top: 50%;
    left: 50%;
    max-width: none;
    transform: translate(-50%, -50%);
  }

  .contact__text {
    position: absolute;
    top: calc(50% - 16px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .contact__arrow {
    position: absolute;
    top: 27px;
    left: calc(50% - 86.32px);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 121.36px;
    height: 86.85px;
    transform: translateX(-50%);
  }

  .contact__arrow img {
    max-width: none;
    transform: rotate(-28.91deg);
  }

  .contact-mobile {
    display: none;
  }

  /* Main 960-1279 */
  @media (max-width: 1279px) {
    .content {
      gap: 44px;
      padding-top: 28px;
    }

    .header {
      gap: 32px;
    }

    .clips {
      --clip-height: 216;
    }
  }

  /* Main 959- */
  @media (max-width: 959px) {
    .content {
      gap: 32px;
      max-width: none;
      padding: 24px 16px 28px;
    }

    .header {
      gap: 24px;
    }

    .texts {
      gap: 16px;
    }

    /* Плитки листаются вбок от края до края экрана */
    .clips {
      --clip-height: 184;

      margin: 0 -16px;
      padding: 0 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .clips::-webkit-scrollbar {
      display: none;
    }

    .desktop-only {
      display: none;
    }

    .contact--desktop {
      display: none;
    }

    .contact-mobile {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .contact-mobile :global(.contacts) {
      width: 180px;
    }
  }
</style>
