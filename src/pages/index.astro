---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import ContactLinks from '../components/ContactLinks.astro';
import video1 from '../assets/home/video-1.mp4';
import video2 from '../assets/home/video-2.mp4';
import video3 from '../assets/home/video-3.mp4';
import poster1 from '../assets/home/posters/video-1.jpg';
import poster2 from '../assets/home/posters/video-2.jpg';
import poster3 from '../assets/home/posters/video-3.jpg';
import { getImage } from 'astro:assets';
import { imageMeta } from '../utils/image';

// Ширина плиток из Figma при высоте 260px; видео заполняет плитку с обрезкой (cover).
// Постер — первый кадр (ffmpeg), сжатый под ретину
const clips = await Promise.all(
  [
    { src: video1, poster: poster1, width: 260, alt: 'Walking in Rome' },
    { src: video2, poster: poster2, width: 195, alt: 'Skiing' },
    { src: video3, poster: poster3, width: 238, alt: 'Playing basketball' },
  ].map(async (clip) => ({
    ...clip,
    poster: (await getImage({ src: clip.poster, width: Math.min(imageMeta(clip.poster).width, clip.width * 2), format: 'webp' })).src,
  })),
);

// Иконки софта из public/soft группами (дизайн, AI, разработка), между группами плюсы.
// Размеры — родные размеры SVG, на странице масштабируются через --soft-scale
const softGroups = [
  {
    label: 'Main design tools',
    items: [
      { icon: 'figma', name: 'Figma', width: 30, height: 44 },
      { icon: 'after', name: 'After Effects', width: 40, height: 40 },
      { icon: 'ps', name: 'Photoshop', width: 40, height: 40 },
    ],
  },
  {
    label: 'AI-friends',
    items: [
      { icon: 'claude', name: 'Claude', width: 40, height: 40 },
      { icon: 'comfy', name: 'ComfyUI', width: 40, height: 40 },
    ],
  },
  {
    label: 'Code base',
    items: [
      { icon: 'github', name: 'GitHub', width: 40, height: 40 },
      { icon: 'html-css', name: 'HTML & CSS', width: 48, height: 40 },
      { icon: 'swift', name: 'Swift', width: 48, height: 40 },
    ],
  },
];
---

<Base
  title="Paulik Liankevich"
  description="Product designer with a penchant for development. Designing interfaces for mobile apps & web. Building digital products. Open for new projects."
  current="home"
>
  <div class="content">
    <header class="header">
      <div class="texts">
        <h1 class="h1">Product designer</h1>
        <p class="h2">With a penchant for development.<br /> Currently open for new projects.</p>
      </div>

      <div class="clips">
        {
          clips.map((clip) => (
            <div class="clip inner-border" style={`--clip-width: ${clip.width}`}>
              {/* Постер ещё и картинкой под видео: пока нет первого кадра, видео прозрачное */}
              <img class="clip__poster" src={clip.poster} alt="" aria-hidden="true" decoding="async" />
              <video src={clip.src} poster={clip.poster} autoplay muted loop playsinline aria-label={clip.alt} />
            </div>
          ))
        }
      </div>
    </header>

    <Timeline />

    <div class="softs" aria-label="Tools" role="group">
      {
        softGroups.map((group, i) => (
          // Плюс в одной обёртке со следующей группой, чтобы при переносе не висел в конце строки
          <div class="softs__item">
            {i > 0 && <span class="softs__plus h3" aria-hidden="true">+</span>}
            <figure class="softs__group">
              <ul class="softs__icons">
                {group.items.map((soft) => (
                  <li class="soft" style={`--w: ${soft.width}; --h: ${soft.height}`}>
                    <img src={`/soft/${soft.icon}.svg`} alt={soft.name} title={soft.name} width={soft.width} height={soft.height} />
                  </li>
                ))}
              </ul>
              <figcaption class="softs__label body">{group.label}</figcaption>
            </figure>
          </div>
        ))
      }
    </div>

    <footer class="footer">
      <p class="h2">
        I want to develop products that move<br class="desktop-only" /> humanity forward, making people healthier<br class="desktop-only" /> and more conscious
      </p>

      <div class="contact contact--desktop">
        <img class="contact__highlight" src="/icons/highlight.svg" alt="" width="252" height="58" />
        <p class="contact__text h3">Let’s stay in touch</p>
        <div class="contact__arrow" aria-hidden="true">
          <img src="/icons/contact-arrow.svg" alt="" width="123" height="34" />
        </div>
      </div>

      <!-- Main 959-: сайдбара нет, контакты прямо под подписью -->
      <div class="contact-mobile">
        <p class="h3">Let’s stay in touch</p>
        <ContactLinks />
      </div>
    </footer>
  </div>
</Base>

<style>
  /* Колонка до 760px с полями по 60px (Scrollable content в Figma) */
  .content {
    display: flex;
    flex-direction: column;
    gap: 52px;
    max-width: calc(var(--column-width) + 2 * 60px);
    margin: 0 auto;
    padding: 32px 60px 100px;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .texts {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .clips {
    --clip-height: 260;

    display: flex;
    gap: 8px;
  }

  /* Ширина из Figma задана при высоте 260px — на меньших экранах масштабируем пропорционально */
  .clip {
    flex: none;
    width: calc(var(--clip-width) / 260 * var(--clip-height) * 1px);
    height: calc(var(--clip-height) * 1px);
    overflow: hidden;
    border-radius: var(--radius-tile);
    background: var(--color-placeholder);
  }

  .clip :is(img, video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .clip__poster {
    position: absolute;
    inset: 0;
  }

  .clip video {
    position: relative;
  }

  .softs {
    --soft-scale: 1.3;
    /* Высота ряда иконок — по самой высокой (Figma, 44px) */
    --soft-row: calc(44px * var(--soft-scale));

    /* Одной строкой без переноса; не влезает — листается вбок */
    display: flex;
    align-items: flex-start;
    gap: 20px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .softs::-webkit-scrollbar {
    display: none;
  }

  .softs__item {
    flex: none;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .softs__group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  .softs__icons {
    display: flex;
    align-items: center;
    gap: 10px;
    height: var(--soft-row);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .soft img {
    display: block;
    width: calc(var(--w) * var(--soft-scale) * 1px);
    height: calc(var(--h) * var(--soft-scale) * 1px);
  }

  .softs__label {
    color: var(--color-secondary);
    white-space: nowrap;
  }

  /* Плюс по центру ряда иконок, подпись под ними не учитывается */
  .softs__plus {
    display: flex;
    align-items: center;
    height: var(--soft-row);
    color: var(--color-secondary);
  }

  @media (max-width: 959px) {
    /* Листается от края до края экрана, как плитки с видео */
    .softs {
      --soft-scale: 1.1;

      gap: 12px;
      margin: 0 -16px;
      padding: 0 16px;
    }

    .softs__item {
      gap: 12px;
    }

    .softs__icons {
      gap: 8px;
    }
  }

  .footer {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* Обведённая от руки подпись со стрелкой к контактам в сайдбаре */
  .contact {
    position: relative;
    width: 198px;
    height: 56px;
  }

  .contact__highlight {
    position: absolute;
    top: 50%;
    left: 50%;
    max-width: none;
    transform: translate(-50%, -50%);
  }

  .contact__text {
    position: absolute;
    top: calc(50% - 16px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .contact__arrow {
    position: absolute;
    top: 27px;
    left: calc(50% - 86.32px);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 121.36px;
    height: 86.85px;
    transform: translateX(-50%);
  }

  .contact__arrow img {
    max-width: none;
    transform: rotate(-28.91deg);
  }

  .contact-mobile {
    display: none;
  }

  /* Main 960-1279 */
  @media (max-width: 1279px) {
    .content {
      gap: 44px;
      padding-top: 28px;
    }

    .header {
      gap: 32px;
    }

    .clips {
      --clip-height: 216;
    }
  }

  /* Main 959- */
  @media (max-width: 959px) {
    .content {
      gap: 32px;
      /* Колонка не шире 640px плюс поля по 16px */
      max-width: calc(640px + 2 * 16px);
      padding: 24px 16px 28px;
    }

    .header {
      gap: 24px;
    }

    .texts {
      gap: 16px;
    }

    /* Плитки листаются вбок от края до края экрана */
    .clips {
      --clip-height: 184;

      margin: 0 -16px;
      padding: 0 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .clips::-webkit-scrollbar {
      display: none;
    }

    .desktop-only {
      display: none;
    }

    .contact--desktop {
      display: none;
    }

    .contact-mobile {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .contact-mobile :global(.contacts) {
      width: 180px;
    }
  }
</style>
