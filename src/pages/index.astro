---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import video1 from '../assets/home/video-1.mp4';
import video2 from '../assets/home/video-2.mp4';
import video3 from '../assets/home/video-3.mp4';

// Ширина плиток из Figma при высоте 260px; видео заполняет плитку с обрезкой (cover)
const clips = [
  { src: video1, width: 260, alt: 'Walking in Rome' },
  { src: video2, width: 195, alt: 'Skiing' },
  { src: video3, width: 238, alt: 'Playing basketball' },
];
---

<Base
  title="Paulik Liankevich"
  description="Product designer with a penchant for development. Currently in Vilnius and open for new projects."
  current="home"
>
  <div class="content">
    <header class="header">
      <div class="texts">
        <h1 class="h1">Product designer</h1>
        <p class="h2">with a penchant for development.<br /> Currently in Vilnius and open for new projects</p>
      </div>

      <div class="clips">
        {
          clips.map((clip) => (
            <div class="clip" style={`--clip-width: ${clip.width}`}>
              <video src={clip.src} autoplay muted loop playsinline aria-label={clip.alt} />
            </div>
          ))
        }
      </div>
    </header>

    <Timeline />

    <footer class="footer">
      <p class="h2">
        I want to develop products that move<br /> humanity forward, making people healthier<br /> and more conscious
      </p>

      <div class="contact">
        <img class="contact__highlight" src="/icons/highlight.svg" alt="" width="252" height="58" />
        <p class="contact__text h3">Let’s stay in touch</p>
        <div class="contact__arrow" aria-hidden="true">
          <img src="/icons/contact-arrow.svg" alt="" width="123" height="34" />
        </div>
      </div>
    </footer>
  </div>
</Base>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: 52px;
    width: min(var(--column-width), calc(100% - 80px));
    margin: 0 auto;
    padding: 32px 0 100px;
  }

  @media (max-width: 1023px) {
    .content {
      gap: 40px;
      width: auto;
      max-width: calc(var(--column-width) + 2 * var(--page-gutter));
      padding: 16px var(--page-gutter) 56px;
    }

    /* Ручные переносы рассчитаны на десктопную ширину */
    .content br {
      display: none;
    }
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .texts {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .clips {
    --clip-height: 260;

    display: flex;
    gap: 8px;
    /* Если не влезают (узкое окно) — листаются вбок */
    overflow-x: auto;
    scrollbar-width: none;
  }

  .clips::-webkit-scrollbar {
    display: none;
  }

  /* На мобилке плитки ниже и листаются от края до края экрана */
  @media (max-width: 1023px) {
    .clips {
      --clip-height: 200;

      margin: 0 calc(-1 * var(--page-gutter));
      padding: 0 var(--page-gutter);
    }
  }

  /* Ширина из Figma задана при высоте 260px — масштабируем пропорционально */
  .clip {
    flex: none;
    width: calc(var(--clip-width) / 260 * var(--clip-height) * 1px);
    height: calc(var(--clip-height) * 1px);
    overflow: hidden;
    border: 1px solid var(--color-tile-border);
    border-radius: var(--radius-tile);
    background: var(--color-placeholder);
  }

  .clip video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .footer {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* Обведённая от руки подпись со стрелкой к контактам в сайдбаре */
  .contact {
    position: relative;
    width: 198px;
    height: 56px;
  }

  .contact__highlight {
    position: absolute;
    top: 50%;
    left: 50%;
    max-width: none;
    transform: translate(-50%, -50%);
  }

  .contact__text {
    position: absolute;
    top: calc(50% - 16px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .contact__arrow {
    position: absolute;
    top: 27px;
    left: calc(50% - 86.32px);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 121.36px;
    height: 86.85px;
    transform: translateX(-50%);
  }

  .contact__arrow img {
    max-width: none;
    transform: rotate(-28.91deg);
  }

  /* Стрелка указывает на контакты в сайдбаре; на мобилке они сразу под ней */
  @media (max-width: 1023px) {
    .contact {
      margin-left: 27px;
    }

    .contact__arrow {
      display: none;
    }
  }
</style>
