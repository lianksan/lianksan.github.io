---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import dmMonoUrl from '@fontsource/dm-mono/files/dm-mono-latin-300-normal.woff2?url';
import Sidebar, { type Page } from '../components/Sidebar.astro';
import MobileNav from '../components/MobileNav.astro';
import ContactLinks from '../components/ContactLinks.astro';

interface Props {
  title: string;
  description: string;
  current: Page;
}

const { title, description, current } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Шрифты грузим сразу, иначе текст при загрузке успевает мигнуть системным шрифтом -->
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmMonoUrl} as="font" type="font/woff2" crossorigin />
    <!-- Переходы между страницами без перезагрузки и без анимации -->
    <ClientRouter fallback="swap" />
    <!-- Фавикон — фото из сайдбара со скруглением, как у аватара -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <Sidebar current={current} />
    <MobileNav current={current} />
    <main class="main">
      <slot />
    </main>
    <!-- На мобилке сайдбара нет — контакты внизу страницы, на них ведёт пункт Contacts в меню -->
    <footer class="contacts" id="contacts">
      <ContactLinks />
    </footer>
  </body>
</html>

<style>
  .main {
    margin-left: var(--sidebar-width);
  }

  .contacts {
    display: none;
  }

  @media (max-width: 1023px) {
    .main {
      margin-left: 0;
    }

    .contacts {
      display: block;
      padding: 24px var(--page-gutter) 40px;
      border-top: 1px solid var(--color-line);
    }
  }
</style>
