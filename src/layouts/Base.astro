---
import '../styles/global.css';
import '../styles/typo.css';
import { withBase } from '../lib/base';

interface Props {
  title: string;
  activeTab?: string;
}

const { title, activeTab = '' } = Astro.props;

const tabs = [
  { href: '/', label: 'Liankevich', id: 'about' },
  { href: '/cases', label: 'Gallery', id: 'cases' },
  { href: '/products', label: 'Products', id: 'products' },
];

const langs = ['RU', 'EN'];
const activeLang = 'EN';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href={withBase('/assets/favicon.png')} />
  <script is:inline>
    (function(){
      var t = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>

  <nav class="nav">
    <div class="nav-tabs">
      {tabs.map(tab => (
        <a href={withBase(tab.href)} class={`tab h4${activeTab === tab.id ? ' active' : ''}`}>{tab.label}</a>
      ))}
      <div class="nav-langs">
        {langs.map(lang => (
          <button type="button" class={`tab h4${lang === activeLang ? ' active' : ''}`} aria-pressed={lang === activeLang ? 'true' : 'false'}>{lang}</button>
        ))}
      </div>
    </div>
  </nav>

  <main class="main">
    <slot />
  </main>

  <slot name="after-main" />

  <script>
    // the menu slides up with the page as it scrolls down (by the same distance, until
    // it's fully gone) and comes back quickly as soon as the page scrolls up
    const nav = document.querySelector<HTMLElement>('.nav')!;
    let lastY = Math.max(scrollY, 0);
    let hidden = 0;
    addEventListener('scroll', () => {
      const y = Math.max(scrollY, 0);  // ignore iOS overscroll at the top
      const dy = y - lastY;
      lastY = y;
      if (dy > 0) {
        hidden = Math.min(hidden + dy, nav.offsetHeight);
        nav.classList.remove('nav--returning');
      } else if (dy < 0 && hidden > 0) {
        hidden = 0;
        nav.classList.add('nav--returning');
      }
      nav.style.transform = hidden ? `translateY(${-hidden}px)` : '';
    }, { passive: true });
  </script>

</body>
</html>
