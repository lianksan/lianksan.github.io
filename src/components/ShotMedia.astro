---
import { withBase } from '../lib/base';

// One gallery image or looping video; `pos` places it in a multishot stack
interface Props {
  src: string;
  extra?: string;
  pos?: number;
}

const { src, extra = '', pos } = Astro.props;
const cls = `shot-img ${extra}`.trim();
---

{/\.mp4$/i.test(src)
  ? <video class={cls} data-pos={pos} src={withBase(src)} autoplay muted loop playsinline></video>
  : <img class={cls} data-pos={pos} src={withBase(src)} alt="" />
}
