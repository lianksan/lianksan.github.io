---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
---

<Image src={avatar} alt="" width={64} height={64} densities={[1, 2, 3]} class="avatar" transition:persist="avatar" />

<style>
  .avatar {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    object-fit: cover;
    transition: transform var(--motion-hover) !important;
  }
</style>
