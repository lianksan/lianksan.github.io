---
import { timeline } from '../data/site';
---

<ol class="timeline">
  {
    timeline.map((entry) => (
      <li class:list={['row', `row--${entry.kind}`]}>
        <span class="date">{entry.date}</span>
        <span class="marker" aria-hidden="true" />
        {entry.kind === 'minor' ? (
          <p class="content body">{entry.text}</p>
        ) : (
          <div class="content">
            <h3 class="h3">{entry.title}</h3>
            <div class="body">
              {entry.text.map((t) => (
                <p>{t}</p>
              ))}
            </div>
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    --row-gap: 28px;
    /* Центр точки от верха строки: по первой строке текста 18px и заголовка 24px */
    --dot-minor: 11px;
    --dot-major: 15px;
    --dot-minor-size: 4px;
    --dot-major-size: 4px;
    /* Зазор между кружком и линией сверху и снизу */
    --line-gap: 4px;
    /* Ширина колонки с точкой и линией */
    --marker: 12px;

    display: flex;
    flex-direction: column;
    gap: var(--row-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    --dot: var(--dot-minor);
    --dot-size: var(--dot-minor-size);

    display: grid;
    grid-template-columns: 126px var(--marker) 1fr;
    grid-template-areas: 'date marker content';
    column-gap: 8px;
    align-items: start;
    color: var(--color-secondary);
  }

  .row--major {
    --dot: var(--dot-major);
    --dot-size: var(--dot-major-size);
  }

  .date {
    grid-area: date;
    font-family: var(--font-mono);
    font-weight: 300;
    text-align: right;
    white-space: nowrap;
  }

  .row--minor .date {
    font-size: 16px;
    line-height: 20px;
    padding-top: 1px;
  }

  .row--major .date {
    font-size: 24px;
    line-height: 29px;
    letter-spacing: -0.02em;
  }

  .row--major .content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .row--major h3 {
    color: var(--color-primary);
  }

  /* Точка и линия до следующей точки */
  .content {
    grid-area: content;
  }

  .marker {
    grid-area: marker;
    position: relative;
    align-self: stretch;
  }

  .marker::before {
    content: '';
    position: absolute;
    top: calc(var(--dot) - var(--dot-size) / 2);
    left: calc(50% - var(--dot-size) / 2);
    width: var(--dot-size);
    height: var(--dot-size);
    border: 1px solid var(--color-secondary);
    border-radius: 50%;
  }

  .row--major .marker::before {
    background: var(--color-secondary);
  }

  .marker::after {
    content: '';
    position: absolute;
    /* От низа своего кружка до верха следующего, с зазором --line-gap */
    top: calc(var(--dot) + var(--dot-size) / 2 + var(--line-gap));
    left: calc(50% - 0.5px);
    width: 1px;
    bottom: calc(var(--line-gap) + var(--dot-minor-size) / 2 - var(--dot-minor) - var(--row-gap));
    background: var(--color-line);
  }

  .row:has(+ .row--major) .marker::after {
    bottom: calc(var(--line-gap) + var(--dot-major-size) / 2 - var(--dot-major) - var(--row-gap));
  }

  .row:last-child .marker::after {
    display: none;
  }

  /* Main 960-1279: Body 16px, H3 и крупные даты 20px */
  @media (max-width: 1279px) {
    .timeline {
      --dot-minor: 10px;
      --dot-major: 13px;
    }

    .row--major .date {
      font-size: 20px;
      line-height: 26px;
    }
  }

  /* Main 959-: точка слева, дата над текстом */
  @media (max-width: 959px) {
    .timeline {
      --row-gap: 20px;
      --dot-major: 14px;
      --marker: 8px;
    }

    .row {
      grid-template-columns: var(--marker) 1fr;
      grid-template-areas:
        'marker date'
        'marker content';
      column-gap: 12px;
      row-gap: 8px;
    }

    .date {
      text-align: left;
    }

    .row--minor .date {
      padding-top: 0;
    }

    .marker {
      grid-row: 1 / -1;
    }
  }
</style>
