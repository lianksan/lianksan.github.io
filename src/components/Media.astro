---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { imageMeta } from '../utils/image';

interface Props {
  /** Картинка из src/assets или URL видео (импорт mp4). */
  src: ImageMetadata | string;
  /** Для видео: первый кадр, который показывается, пока видео не загрузилось */
  poster?: ImageMetadata;
  ratio: string;
  alt: string;
  sizes: string;
  style?: string;
  /** Тянется на высоту ряда вместо своих пропорций (стили — в shots.astro) */
  fill?: boolean;
}

const { src, poster, ratio, alt, sizes, style = '', fill = false } = Astro.props;
const isImage = typeof src === 'object';
// Размеры и формат читаем через imageMeta, иначе оригинал картинки попадёт в сборку
const meta = isImage ? imageMeta(src) : undefined;
const isGif = meta?.format === 'gif';
const widths = meta && [400, 900, 1800].filter((w) => w < meta.width).concat(Math.min(meta.width, 1800));

// Для полноэкранного просмотра (Lightbox.astro): картинка в исходном размере, GIF как есть.
// Видео в оверлей переносится тем же элементом, поэтому URL не нужен.
const full = !isImage ? 'video' : isGif ? src.src : (await getImage({ src, format: 'webp', quality: 90 })).src;
const size = meta ? { 'data-width': meta.width, 'data-height': meta.height } : {};

// Постер видео сжимаем под ширину плитки ×2 (ретина), но не больше исходника.
// Ширина плитки — последнее значение в sizes; до 680px плитка во всю ширину экрана
const tileWidth = Math.max(parseInt(sizes.split(',').pop()!, 10), 680);
const posterWidth = poster && Math.min(imageMeta(poster).width, tileWidth * 2);
const posterSrc = poster && (await getImage({ src: poster, width: posterWidth, format: 'webp' })).src;
---

<!-- Любая плитка открывается на весь экран по клику, поэтому это кнопка -->
<button
  type="button"
  class:list={['media inner-border', { 'media--fill': fill }]}
  style={`aspect-ratio: ${ratio}; ${style}`}
  data-lightbox={full}
  {...size}
  aria-label={`Open ${alt || 'shot'} fullscreen`}
>
  {
    typeof src === 'string' ? (
      // Видео грузится и играет, только когда видно на экране (см. скрипт ниже).
      // Постер — ещё и картинкой под видео: браузер убирает poster раньше, чем покажет первый кадр,
      // а пустое видео прозрачное, поэтому в этот момент виден постер, а не пустая плитка
      <>
        {posterSrc && <img class="media__poster" src={posterSrc} alt="" aria-hidden="true" decoding="async" />}
        <video src={src} poster={posterSrc} muted loop playsinline preload="none" data-inview-play aria-label={alt} />
      </>
    ) : isGif ? (
      // GIF не пропускаем через оптимизацию, иначе пропадёт анимация
      <img src={src.src} width={meta!.width} height={meta!.height} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <Image src={src} alt={alt} widths={widths || undefined} sizes={sizes} />
    )
  }
</button>

<script>
  let observer: IntersectionObserver | undefined;
  const visible = new Set<HTMLVideoElement>();

  function setup() {
    observer?.disconnect();
    visible.clear();
    observer = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting } of entries) {
          const video = target as HTMLVideoElement;
          if (isIntersecting) {
            visible.add(video);
            video.play().catch(() => {});
          } else {
            visible.delete(video);
            video.pause();
          }
        }
      },
      { rootMargin: '200px 0px' },
    );
    document.querySelectorAll('video[data-inview-play]').forEach((v) => observer!.observe(v));
  }

  // Срабатывает и при первой загрузке, и после клиентских переходов
  document.addEventListener('astro:page-load', setup);

  // Браузер ставит видео на паузу в скрытой вкладке — при возвращении запускаем видимые
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) visible.forEach((v) => v.play().catch(() => {}));
  });
</script>

<style>
  .media {
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: none;
    border-radius: var(--radius-tile);
    background: var(--color-placeholder);
    cursor: zoom-in;
  }

  .media :is(img, video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* На мобилке оверлея нет (см. Lightbox.astro), скругление меньше */
  @media (max-width: 959px) {
    .media {
      border-radius: calc(var(--radius-tile) - 4px);
      cursor: default;
    }
  }

  /* Постер под видео, видео поверх */
  .media__poster {
    position: absolute;
    inset: 0;
  }

  .media video {
    position: relative;
  }
</style>
