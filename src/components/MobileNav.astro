---
import Avatar from './Avatar.astro';
import type { Page } from './Sidebar.astro';
import { nav, person } from '../data/site';

interface Props {
  current: Page;
}

const { current } = Astro.props;
const here = (page: Page) => (current === page ? 'page' : undefined);
---

<!-- Main 959-: замена сайдбара — строка ссылок сверху страницы. Не влезает — листается вбок -->
<nav class="topbar" aria-label="Main">
  <ul class="topbar__links">
    <li>
      <a class="home link h3" href={nav.home} aria-current={here('home')}>
        <Avatar size={24} persist="avatar-mobile" />
        <span>{person.firstName}</span>
      </a>
    </li>
    <li><a class="link h3" href={nav.shots} aria-current={here('shots')}>Gallery</a></li>
    <li><a class="link h3" href={nav.cases} aria-current={here('cases')}>Cases</a></li>
    <li><a class="link h3" href={nav.products} aria-current={here('products')}>Products</a></li>
  </ul>
</nav>

<style>
  .topbar {
    display: none;
  }

  @media (max-width: 959px) {
    .topbar {
      display: block;
      overflow-x: auto;
      scrollbar-width: none;
    }
  }

  .topbar::-webkit-scrollbar {
    display: none;
  }

  .topbar__links {
    display: flex;
    gap: 12px;
    width: max-content;
    height: 44px;
    margin: 0;
    padding: 0 16px;
    list-style: none;
  }

  .topbar__links a {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 7px 0 8px;
    white-space: nowrap;
  }

  .home {
    gap: 6px;
    text-decoration-line: none;
  }

  /* Подчёркиваем только имя, как в сайдбаре */
  .home span {
    text-decoration: underline;
    text-decoration-color: inherit;
    text-decoration-thickness: inherit;
    text-underline-position: from-font;
  }

  .home[aria-current='page'] :global(.avatar),
  .home:hover :global(.avatar) {
    transform: rotate(-3deg);
  }
</style>
